{
  "name": "my-fullstack-app",
  "private": true,
  "scripts": {
    "dev:backend": "PORT=3001 pnpm --filter backend dev",
    "dev:frontend": "pnpm --filter frontend dev",
    "dev": "concurrently -n \"Hono,Next.js\" -c \"blue,green\" \"pnpm dev:backend\" \"pnpm dev:frontend\"",
    "test": "pnpm -r test",
    "test:backend": "pnpm --filter backend test",
    "test:frontend": "pnpm --filter frontend test",
    "test:e2e": "pnpm --filter e2e-tests test",
    "test:e2e:ui": "pnpm --filter e2e-tests test:ui",
    "install:all": "pnpm install"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
